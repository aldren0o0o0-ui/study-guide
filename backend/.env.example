# Application
APP_NAME=StudyGuide API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# CORS (comma-separated origins or JSON list)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Database (PostgreSQL + psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/studyguide
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis & RQ Background Queue
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=document_processing
PROCESSING_JOB_TIMEOUT_SECONDS=300
PROCESSING_EAGER_FALLBACK=false

# Authentication & JWT (Generate a 32+ byte secret in production: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=replace-with-secure-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=studyguide-api
JWT_AUDIENCE=studyguide-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Document Storage & Upload Limits
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.storage/documents
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=studyguide-documents
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_BYTES=26214400

# Gemini Embeddings & Document Chunking (Phase 4)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=200

# In-Depth Analysis & Structured Generation (Phase 5)
GEMINI_GENERATION_MODEL=gemini-2.5-flash
ANALYSIS_MAX_DOCUMENTS=10
ANALYSIS_MAX_CONTEXT_CHARS=32000
ANALYSIS_TOP_K_CHUNKS=24

# Voice Practice & Gemini Live Gateway (Phase 3 & Phase 4)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
VOICE_ALLOW_IN_MEMORY_FALLBACK=false
VOICE_TICKET_TTL_SECONDS=60
VOICE_MAX_SESSION_DURATION_SECONDS=600
VOICE_SESSION_WARNING_SECONDS=570
VOICE_MAX_CONCURRENT_SESSIONS_PER_USER=1
VOICE_MAX_GLOBAL_CONCURRENT_SESSIONS=3
VOICE_MAX_DAILY_SESSIONS_PER_USER=3
VOICE_MAX_AUDIO_FRAME_BYTES=65536
VOICE_MAX_JSON_MESSAGE_BYTES=16384
VOICE_RAG_TOP_K_CHUNKS=8
VOICE_RAG_MAX_CONTEXT_CHARS=12000
